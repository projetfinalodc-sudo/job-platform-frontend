REACT_APP_API_URL=http://localhost:8080/api

# Désactive le plugin ESLint interne de react-scripts (conflit de versions connu
# entre react-scripts 5 et des versions récentes d'eslint-config-react-app /
# eslint-plugin-jest, sans lien avec la qualité du code de ce projet). Le lint
# reste actif normalement dans VS Code via son extension ESLint.
DISABLE_ESLINT_PLUGIN=true
